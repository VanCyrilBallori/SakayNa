rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userDocPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function userDocumentExists() {
      return signedIn() && exists(userDocPath(request.auth.uid));
    }

    function userData() {
      return get(userDocPath(request.auth.uid)).data;
    }

    function userRole() {
      return userData().role;
    }

    function isAdmin() {
      return userDocumentExists() && userRole() == "Admin";
    }

    function isDispatcher() {
      return userDocumentExists() && userRole() == "Dispatcher";
    }

    function isDriver() {
      return userDocumentExists() && userRole() == "Driver";
    }

    function isApprovedDriver() {
      return isDriver() && userData().accountStatus == "Approved";
    }

    match /users/{userId} {
      allow read: if isAdmin() || isDispatcher() || (signedIn() && request.auth.uid == userId);

      allow create: if signedIn()
        && request.auth.uid == userId
        && (
          (
            request.resource.data.role == "Resident"
            && (
              !request.resource.data.keys().hasAny(["accountStatus"])
              || request.resource.data.accountStatus == "Active"
            )
          )
          ||
          (
            request.resource.data.role == "Driver"
            && request.resource.data.accountStatus == "Pending"
          )
        );

      allow update: if (isAdmin() && request.auth.uid != userId)
        || (
          signedIn()
          && request.auth.uid == userId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "fullName",
            "email",
            "phone",
            "phoneNumber",
            "barangay",
            "address",
            "availability",
            "presence",
            "lastSeenAt",
            "updatedAt"
          ])
        );

      allow delete: if false;
    }

    function isValidNewResidentRequest() {
      return request.resource.data.keys().hasOnly([
        "residentId", "residentName", "reference", "category", "requestType", "status",
        "residentReportedUrgency", "level", "priorityLevel", "title", "emergencyType",
        "serviceType", "vehicle", "vehicleType", "passengerCapacity", "passengerName",
        "contactNumber", "barangay", "pickupLocation", "pickup", "pickupDetails",
        "destination", "destinationLocation", "summary", "description", "vulnerableGroups",
        "accessibilityNotes", "additionalNotes", "timeline", "createdAt", "updatedAt"
      ])
        && request.resource.data.keys().hasAll([
          "residentId", "residentName", "reference", "category", "requestType", "status",
          "serviceType", "passengerCapacity", "passengerName", "contactNumber", "barangay",
          "pickupLocation", "pickup", "pickupDetails", "destination", "destinationLocation",
          "description", "timeline", "createdAt", "updatedAt"
        ])
        && request.resource.data.residentId == request.auth.uid
        && request.resource.data.status == "Pending"
        && request.resource.data.category in ["Community Transport Request", "Emergency Request"]
        && request.resource.data.requestType == request.resource.data.category
        && request.resource.data.residentReportedUrgency in ["Standard", "Emergency"]
        && request.resource.data.level in ["Urgent", "Non-Urgent", "Planned"]
        && request.resource.data.priorityLevel == request.resource.data.level
        && request.resource.data.reference is string
        && request.resource.data.reference.size() >= 8
        && request.resource.data.reference.size() <= 24
        && request.resource.data.serviceType is string
        && request.resource.data.serviceType.size() > 0
        && request.resource.data.serviceType.size() <= 100
        && request.resource.data.passengerName is string
        && request.resource.data.passengerName.size() > 0
        && request.resource.data.passengerName.size() <= 80
        && request.resource.data.contactNumber is string
        && request.resource.data.contactNumber.matches('^\\+639[0-9]{9}$')
        && request.resource.data.barangay is string
        && request.resource.data.barangay.size() > 0
        && request.resource.data.barangay.size() <= 80
        && request.resource.data.pickupLocation is string
        && request.resource.data.pickupLocation.size() > 0
        && request.resource.data.pickupLocation.size() <= 180
        && request.resource.data.pickup is map
        && request.resource.data.pickup.keys().hasOnly(["latitude", "longitude", "address", "barangay", "source"])
        && request.resource.data.pickup.address == request.resource.data.pickupLocation
        && request.resource.data.pickup.source in ["gps", "map", "manual"]
        && request.resource.data.pickupDetails is string
        && request.resource.data.pickupDetails.size() > 0
        && request.resource.data.pickupDetails.size() <= 300
        && request.resource.data.destination is string
        && request.resource.data.destination.size() <= 180
        && request.resource.data.destinationLocation is map
        && request.resource.data.destinationLocation.keys().hasOnly(["address", "latitude", "longitude", "source"])
        && request.resource.data.destinationLocation.address == request.resource.data.destination
        && request.resource.data.destinationLocation.source in ["manual", "nearest-facility"]
        && request.resource.data.description is string
        && request.resource.data.description.size() > 0
        && request.resource.data.description.size() <= 500
        && request.resource.data.timeline is map
        && request.resource.data.timeline.keys().hasOnly(["submitted"])
        && request.resource.data.timeline.submitted is map
        && request.resource.data.timeline.submitted.keys().hasOnly(["actorRole", "actorId", "note"])
        && request.resource.data.timeline.submitted.actorRole == "Resident"
        && request.resource.data.timeline.submitted.actorId == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
    }

    function isValidResidentCancellation() {
      return signedIn()
        && resource.data.residentId == request.auth.uid
        && resource.data.status in ["Pending", "Assigned"]
        && request.resource.data.status == "Cancelled"
        && request.resource.data.previousStatus == resource.data.status
        && request.resource.data.cancelledBy == request.auth.uid
        && request.resource.data.cancellationReason is string
        && request.resource.data.cancellationReason.size() >= 3
        && request.resource.data.cancellationReason.size() <= 240
        && request.resource.data.cancelledAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "status", "previousStatus", "cancelledBy", "cancellationReason", "cancelledAt", "updatedAt", "timeline"
        ])
        && request.resource.data.timeline is map
        && request.resource.data.timeline.cancelled is map
        && request.resource.data.timeline.cancelled.keys().hasOnly(["actorRole", "actorId", "note"])
        && request.resource.data.timeline.cancelled.actorRole == "Resident"
        && request.resource.data.timeline.cancelled.actorId == request.auth.uid
        && request.resource.data.timeline.cancelled.note == request.resource.data.cancellationReason
        && (
          (!('timeline' in resource.data) && request.resource.data.timeline.keys().hasOnly(["cancelled"]))
          || (
            ('timeline' in resource.data)
            && request.resource.data.timeline.keys().hasOnly(["submitted", "cancelled"])
            && request.resource.data.timeline.submitted == resource.data.timeline.submitted
          )
        );
    }

    function isDriverMissionRequestUpdate() {
      return isApprovedDriver()
        && resource.data.assignedDriverId == request.auth.uid
        && request.resource.data.assignedDriverId == resource.data.assignedDriverId
        && request.resource.data.residentId == resource.data.residentId
        && resource.data.status in ["Assigned", "In Progress"]
        && request.resource.data.status in ["Pending", "In Progress", "Completed"]
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "status", "missionStatus", "acceptedAt", "enRouteAt", "arrivedAt", "pickedUpAt", "completedAt",
          "updatedAt", "timeline", "lastDeclinedDriverId", "lastDeclineReason", "assignedDriverId",
          "assignedDriverName", "assignedVehicleId", "assignedVehicleName", "vehicleId", "vehicle",
          "vehiclePlateNumber"
        ]);
    }

    function isDriverMissionAssignmentUpdate() {
      return isApprovedDriver()
        && resource.data.driverId == request.auth.uid
        && request.resource.data.driverId == resource.data.driverId
        && request.resource.data.requestId == resource.data.requestId
        && request.resource.data.dispatcherId == resource.data.dispatcherId
        && request.resource.data.vehicleId == resource.data.vehicleId
        && resource.data.status in ["Assigned", "In Progress"]
        && request.resource.data.status in ["In Progress", "Completed", "Declined"]
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "status", "missionStatus", "acceptedAt", "acceptedBy", "vehicleChecklistId", "enRouteAt",
          "arrivedAt", "pickedUpAt", "completedAt", "completionOutcome", "completionNotes",
          "completionIssues", "declinedAt", "declinedBy", "declineReason", "declineDetails",
          "previousStatus", "updatedAt"
        ]);
    }
    match /transportRequests/{requestId} {
      allow create: if signedIn() && isValidNewResidentRequest();

      allow read: if isAdmin()
        || isDispatcher()
        || (signedIn() && resource.data.residentId == request.auth.uid)
        || (isApprovedDriver() && resource.data.assignedDriverId == request.auth.uid);

      allow update, delete: if false;
    }
    match /driverAssignments/{assignmentId} {
      allow read: if isAdmin() || isDispatcher() || (signedIn() && resource.data.driverId == request.auth.uid);
      allow create: if isAdmin() || isDispatcher();
      allow update: if isAdmin() || isDispatcher() || isDriverMissionAssignmentUpdate();
      allow delete: if isAdmin() || isDispatcher();
    }

    match /vehicleChecklists/{checklistId} {
      allow read: if isAdmin() || isDispatcher() || (isApprovedDriver() && resource.data.driverId == request.auth.uid);
      allow create: if isApprovedDriver()
        && request.resource.data.driverId == request.auth.uid
        && request.resource.data.ready == true
        && request.resource.data.vehicleId is string
        && request.resource.data.assignmentId is string
        && get(/databases/$(database)/documents/driverAssignments/$(request.resource.data.assignmentId)).data.driverId == request.auth.uid
        && get(/databases/$(database)/documents/driverAssignments/$(request.resource.data.assignmentId)).data.vehicleId == request.resource.data.vehicleId;
      allow update, delete: if false;
    }
    match /callSessions/{callId} {
      allow create: if signedIn()
        && request.resource.data.residentId == request.auth.uid
        && request.resource.data.targetRole == "Dispatcher"
        && request.resource.data.status == "ringing";

      allow read: if isAdmin()
        || isDispatcher()
        || (signedIn() && resource.data.residentId == request.auth.uid);

      allow update: if isAdmin()
        || isDispatcher()
        || (
          signedIn()
          && resource.data.residentId == request.auth.uid
          && request.resource.data.residentId == resource.data.residentId
        );

      allow delete: if isAdmin() || isDispatcher();
    }

    match /Driver_Applications/{applicationId} {
      allow create: if signedIn()
        && request.resource.data.driverUid == request.auth.uid
        && request.resource.data.status == "Pending";

      allow read: if isAdmin()
        || (signedIn() && resource.data.driverUid == request.auth.uid);

      allow update: if false;

      allow delete: if false;
    }

    match /vehicles/{vehicleId} {
      allow read: if isAdmin() || isDispatcher() || isApprovedDriver();
      allow create, update, delete: if false;
    }
    match /driverSchedules/{scheduleId} {
      allow read: if isAdmin()
        || isDispatcher()
        || (signedIn() && resource.data.driverUid == request.auth.uid);

      allow create: if isAdmin()
        || isDispatcher()
        || (
          isApprovedDriver()
          && request.resource.data.driverUid == request.auth.uid
        );

      allow update: if isAdmin()
        || isDispatcher()
        || (
          isApprovedDriver()
          && resource.data.driverUid == request.auth.uid
          && request.resource.data.driverUid == resource.data.driverUid
        );

      allow delete: if isAdmin()
        || isDispatcher()
        || (
          isApprovedDriver()
          && resource.data.driverUid == request.auth.uid
        );
    }

    match /staffInvitations/{invitationId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.intendedRole == "Dispatcher"
        && request.resource.data.status == "Pending Invitation"
        && request.resource.data.email is string;
      allow update: if isAdmin();
      allow delete: if false;
    }

    match /deletionRequests/{requestId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.requestedBy == request.auth.uid
        && request.resource.data.status == "Pending backend processing"
        && request.resource.data.targetUserId is string;
      allow update, delete: if false;
    }

    match /vehicleMaintenance/{maintenanceId} {
      allow read, create, update: if isAdmin();
      allow delete: if false;
    }

    match /activityLogs/{logId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    match /systemSettings/{settingId} {
      allow read, create, update: if isAdmin();
      allow delete: if false;
    }
    match /authoritativeAuditLogs/{logId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
