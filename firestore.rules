rules_version = '2';

// SakayNa security rules (simplified single-app version).
// The app writes to Firestore directly; there is no Cloud Functions backend.
// Access is role-based, read from the caller's users/{uid} profile document.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function profileExists() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function myRole() {
      return profileExists()
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : "";
    }

    function isAdmin()      { return myRole() == "Admin"; }
    function isDispatcher() { return myRole() == "Dispatcher"; }
    function isStaff()      { return isAdmin() || isDispatcher(); }
    function isDriver()     { return myRole() == "Driver"; }

    // A brand-new self-created profile may only be an unapproved Resident or an
    // unapproved (Pending) Driver applicant. Dispatcher and Admin accounts are
    // always provisioned by an Admin through the Firebase console, never by the
    // app itself, so self-signup can never produce one.
    function selfCreateProfileIsSafe() {
      return (request.resource.data.role == "Resident" && request.resource.data.accountStatus == "Active")
        || (request.resource.data.role == "Driver" && request.resource.data.accountStatus == "Pending");
    }

    // A self-update (by the profile's own owner) may never change role or
    // accountStatus. Those fields may only move through isAdmin()/isStaff() paths.
    function keepsRoleAndStatus() {
      return request.resource.data.role == resource.data.role
        && request.resource.data.accountStatus == resource.data.accountStatus;
    }

    // ---- User profiles ----
    match /users/{userId} {
      allow read:   if signedIn() && (request.auth.uid == userId || isStaff());
      allow create: if signedIn() && request.auth.uid == userId && selfCreateProfileIsSafe();
      allow update: if signedIn() && (
        (request.auth.uid == userId && keepsRoleAndStatus()) || (isAdmin() && request.auth.uid != userId)
      );
      allow delete: if false;
    }

    // ---- Resident transport requests ----
    match /transportRequests/{requestId} {
      allow read: if isStaff()
        || (signedIn() && resource.data.residentId == request.auth.uid)
        || (isDriver() && resource.data.assignedDriverId == request.auth.uid);
      allow create: if signedIn() && request.resource.data.residentId == request.auth.uid;
      allow update: if isStaff()
        || (signedIn() && resource.data.residentId == request.auth.uid)
        || (isDriver() && resource.data.assignedDriverId == request.auth.uid);
      allow delete: if isAdmin();
    }

    // ---- Dispatcher -> driver assignments ----
    match /driverAssignments/{assignmentId} {
      allow read:   if isStaff() || (isDriver() && resource.data.driverId == request.auth.uid);
      allow create: if isStaff();
      allow update: if isStaff() || (isDriver() && resource.data.driverId == request.auth.uid);
      allow delete: if isStaff();
    }

    // ---- Vehicles ----
    match /vehicles/{vehicleId} {
      allow read:           if isStaff() || isDriver();
      allow create, delete: if isAdmin();
      allow update:         if isAdmin() || isStaff() || isDriver();
    }

    // ---- Driver availability schedules ----
    match /driverSchedules/{scheduleId} {
      allow read:  if isStaff() || isDriver();
      allow write: if isStaff() || isDriver();
    }

    // ---- In-app emergency call signaling ----
    match /callSessions/{callId} {
      allow read:   if isStaff() || (signedIn() && resource.data.residentId == request.auth.uid);
      allow create: if signedIn() && request.resource.data.residentId == request.auth.uid;
      allow update: if isStaff() || (signedIn() && resource.data.residentId == request.auth.uid);
      allow delete: if isStaff();
    }

    // ---- Driver applications ----
    match /Driver_Applications/{applicationId} {
      allow read:   if isAdmin() || (signedIn() && resource.data.driverUid == request.auth.uid);
      allow create: if signedIn() && request.resource.data.driverUid == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if false;
    }

    // ---- Vehicle readiness checklists ----
    match /vehicleChecklists/{checklistId} {
      allow read:           if isStaff() || isDriver();
      allow create, update: if isDriver();
      allow delete:         if false;
    }

    // ---- Admin bookkeeping (used by the Operations panel) ----
    match /activityLogs/{logId} {
      allow read, create:   if isStaff();
      allow update, delete: if false;
    }
    match /vehicleMaintenance/{id} { allow read, write: if isAdmin(); }
    match /staffInvitations/{id}   { allow read, write: if isAdmin(); }
    match /deletionRequests/{id}   { allow read, write: if isAdmin(); }
    match /systemSettings/{id} {
      allow read:  if isStaff();
      allow write: if isAdmin();
    }

    // ---- Everything else is denied ----
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
