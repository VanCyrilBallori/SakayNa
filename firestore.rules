rules_version = '2';

// SakayNa security rules (simplified single-app version).
// The app writes to Firestore directly; there is no Cloud Functions backend.
// Access is role-based, read from the caller's users/{uid} profile document.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function profileExists() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function myRole() {
      return profileExists()
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : "";
    }

    function isAdmin()      { return myRole() == "Admin"; }
    function isDispatcher() { return myRole() == "Dispatcher"; }
    function isStaff()      { return isAdmin() || isDispatcher(); }
    function isDriver()     { return myRole() == "Driver"; }

    // Only a verified (Active) Resident may send a new emergency alert or transport request.
    // Pending and Rejected Residents are blocked here too, not just in the app.
    function isActiveResident() {
      return myRole() == "Resident"
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.accountStatus == "Active";
    }

    // The barangay on the caller's own profile ("" if none).
    function myBarangay() {
      return profileExists()
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get("barangay", "")
        : "";
    }

    // An Admin in charge of this barangay. Each Admin gets a barangay in the Firebase Console.
    function isAdminOf(barangay) {
      return isAdmin() && barangay != "" && myBarangay() == barangay;
    }

    // A brand-new self-created profile may only be an unapproved Resident or an
    // unapproved (Pending) Driver applicant. Dispatcher accounts are made by an
    // Admin (see adminCreatesDispatcherIsSafe) and Admin accounts in the Firebase
    // console, so self-signup can never produce either.
    // A new Resident starts "Pending" until an Admin verifies their proof of residency.
    // A new Driver starts "Pending" until an Admin reviews their application.
    // Both need a verified email (Google sign-ins are verified automatically).
    function selfCreateProfileIsSafe() {
      return (request.resource.data.role == "Resident"
          && request.resource.data.accountStatus == "Pending"
          && request.auth.token.email_verified == true)
        || (request.resource.data.role == "Driver"
          && request.resource.data.accountStatus == "Pending"
          && request.auth.token.email_verified == true);
    }

    // An Admin may create someone else's profile in Admin Operations, but only
    // as an Active Dispatcher, stamped with that Admin's uid. Never an Admin,
    // Driver or Resident.
    function adminCreatesDispatcherIsSafe() {
      return request.resource.data.role == "Dispatcher"
        && request.resource.data.accountStatus == "Active"
        && request.resource.data.get("createdBy", "") == request.auth.uid;
    }

    // A self-update (by the profile's own owner) may never change these
    // fields. Only an Admin may change them. The barangay is locked after sign-up.
    function keepsAdminOnlyFields() {
      return !request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(["role", "accountStatus", "approvalStatus",
                 "approvalReviewedAt", "approvalReviewedBy", "barangay"]);
    }

    // ---- Driver duty status (driver-duty-plan.md) ----
    // A driver's current status is saved on their own users/{uid} profile.
    // Every change is also saved as a new dutyRecords document in the same save.

    function isApprovedDriver() {
      return isDriver()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.accountStatus == "Approved";
    }

    // The profile fields that hold the duty status.
    function dutyFields() {
      return ["dutyStatus", "dutyStatusSince", "shiftId", "shiftStartedAt", "breakType", "breakNote"];
    }

    // The only allowed status changes. "On a run" is set by the app when the driver accepts a ride.
    function allowedDutyChange(before, after) {
      return (before == "Off duty" && after == "Available")
        || (before == "Available" && after in ["On break", "On a run", "Off duty"])
        || (before == "On break" && after in ["Available", "Off duty"])
        || (before == "On a run" && after == "Available");
    }

    // A driver's own profile save may leave the duty fields alone (Settings, the
    // app-open "presence" signal), or make one allowed change, stamped with
    // Firestore's own clock (request.time), never the phone's.
    // A driver who never punched in has no dutyStatus: that counts as "Off duty".
    function dutyChangeIsSafe() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(dutyFields())
        || (isApprovedDriver()
          && allowedDutyChange(resource.data.get("dutyStatus", "Off duty"), request.resource.data.get("dutyStatus", ""))
          && request.resource.data.dutyStatusSince == request.time
          // Punch in: the shift starts now and gets an id.
          && (resource.data.get("dutyStatus", "Off duty") != "Off duty"
            || (request.resource.data.shiftStartedAt == request.time
              && request.resource.data.shiftId is string
              && request.resource.data.shiftId.size() > 0))
          // Start a break: a known break type and a short note.
          // "Lunch" replaced "Meal" (Oct 2026); "Meal" stays allowed for drivers on the older APK.
          && (request.resource.data.dutyStatus != "On break"
            || (request.resource.data.get("breakType", "") in ["Lunch", "Meal", "Rest", "Personal"]
              && request.resource.data.get("breakNote", "") is string
              && request.resource.data.get("breakNote", "").size() <= 100)));
    }

    // Which status each duty record goes with.
    function dutyRecordStatus() {
      return {
        "Punch in": "Available",
        "Break start": "On break",
        "Break end": "Available",
        "Run start": "On a run",
        "Run end": "Available",
        "Punch out": "Off duty"
      };
    }

    // The driver's profile as it will be after this save.
    function myProfileAfter() {
      return getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // A new duty record must be the driver's own, use Firestore's clock, and be saved
    // together with the matching status change on their profile (same save, same moment).
    // On punch out the profile keeps its shiftId, so the "Punch out" record still matches it.
    function dutyRecordIsSafe() {
      return request.resource.data.driverId == request.auth.uid
        && request.resource.data.at == request.time
        && request.resource.data.type in dutyRecordStatus()
        && myProfileAfter().get("dutyStatus", "") == dutyRecordStatus()[request.resource.data.type]
        && myProfileAfter().get("dutyStatusSince", null) == request.time
        && request.resource.data.get("shiftId", "") == myProfileAfter().get("shiftId", "");
    }

    // ---- User profiles ----
    match /users/{userId} {
      allow read:   if signedIn() && (request.auth.uid == userId || isStaff());
      // A new profile may not start with a duty status (a driver must punch in).
      allow create: if signedIn()
        && ((request.auth.uid == userId && selfCreateProfileIsSafe())
          || (isAdmin() && request.auth.uid != userId && adminCreatesDispatcherIsSafe()))
        && !request.resource.data.keys().hasAny(dutyFields());
      allow update: if signedIn() && (
        (request.auth.uid == userId && keepsAdminOnlyFields() && dutyChangeIsSafe()) || (isAdmin() && request.auth.uid != userId)
      );
      allow delete: if false;
    }

    // A dispatcher may create a ride for a resident, but only from an emergency alert
    // this same dispatcher answered, for that same resident (emergency-request-form-plan.md).
    // The alert may already be "ended": residents often tap Done while the dispatcher is still typing.
    function dispatcherRideFromAlertIsSafe() {
      return isDispatcher()
        && request.resource.data.get("createdBy", "") == request.auth.uid
        && request.resource.data.get("emergencyAlertId", "") is string
        && request.resource.data.get("emergencyAlertId", "").size() > 0
        && get(/databases/$(database)/documents/callSessions/$(request.resource.data.emergencyAlertId)).data.dispatcherId == request.auth.uid
        && get(/databases/$(database)/documents/callSessions/$(request.resource.data.emergencyAlertId)).data.residentId == request.resource.data.residentId;
    }

    // ---- Resident transport requests ----
    match /transportRequests/{requestId} {
      allow read: if isStaff()
        || (signedIn() && resource.data.residentId == request.auth.uid)
        || (isDriver() && resource.data.assignedDriverId == request.auth.uid);
      allow create: if (isActiveResident() && request.resource.data.residentId == request.auth.uid)
        || dispatcherRideFromAlertIsSafe();
      allow update: if isStaff()
        || (signedIn() && resource.data.residentId == request.auth.uid)
        || (isDriver() && resource.data.assignedDriverId == request.auth.uid);
      allow delete: if isAdmin();
    }

    // ---- Dispatcher -> driver assignments ----
    match /driverAssignments/{assignmentId} {
      allow read:   if isStaff() || (isDriver() && resource.data.driverId == request.auth.uid);
      // A ride can only be given to a driver who is punched in and free ("Available") (driver-duty-plan.md).
      // A driver who never punched in has no dutyStatus: that counts as "Off duty".
      allow create: if isStaff()
        && get(/databases/$(database)/documents/users/$(request.resource.data.driverId)).data.get("dutyStatus", "Off duty") == "Available";
      allow update: if isStaff() || (isDriver() && resource.data.driverId == request.auth.uid);
      allow delete: if isStaff();
    }

    // ---- Vehicles ----
    // Drivers free a van when they complete a ride, can't do it, or the resident cancelled.
    // Only an Approved driver: a Pending applicant has the Driver role too (architecture-review.md C1).
    match /vehicles/{vehicleId} {
      allow read:           if isStaff() || isDriver();
      allow create, delete: if isAdmin();
      allow update:         if isAdmin() || isStaff() || isApprovedDriver();
    }

    // ---- Driver availability schedules ----
    // Approved drivers only, like vehicles (architecture-review.md C1).
    match /driverSchedules/{scheduleId} {
      allow read:  if isStaff() || isDriver();
      allow write: if isStaff() || isApprovedDriver();
    }

    // ---- Driver duty records (the DTR) ----
    // Append-only: a record is never edited or deleted, not even by an Admin.
    match /dutyRecords/{recordId} {
      allow read:   if isStaff() || (signedIn() && resource.data.driverId == request.auth.uid);
      allow create: if isApprovedDriver() && dutyRecordIsSafe();
      allow update, delete: if false;
    }

    // ---- Driver's last known location (driver-location-plan.md) ----
    // One document per driver (id = their uid), replaced at each step, erased at punch out.
    // Saved only when the driver taps Punch in, Accept, En route, Arrived or Picked up, while on duty.
    // Only dispatchers may read it (not admins, not residents), and the driver their own.
    match /driverLocations/{driverId} {
      allow read:   if isDispatcher() || (signedIn() && request.auth.uid == driverId);
      allow create, update: if signedIn() && request.auth.uid == driverId
        && isApprovedDriver()
        && get(/databases/$(database)/documents/users/$(driverId)).data.get("dutyStatus", "Off duty") != "Off duty"
        && request.resource.data.keys().hasOnly(["latitude", "longitude", "step", "at"])
        && request.resource.data.latitude is number
        && request.resource.data.latitude >= -90 && request.resource.data.latitude <= 90
        && request.resource.data.longitude is number
        && request.resource.data.longitude >= -180 && request.resource.data.longitude <= 180
        && request.resource.data.step in ["Punch in", "Accepted", "En Route", "Arrived", "Picked Up"]
        && request.resource.data.at == request.time;
      allow delete: if signedIn() && request.auth.uid == driverId;
    }

    // ---- In-app emergency call signaling ----
    match /callSessions/{callId} {
      // resource == null: the resident's app starts watching its new alert while the alert is
      // still being saved. A not-yet-existing alert has nothing to show, so this is safe.
      allow read:   if isStaff() || (signedIn() && (resource == null || resource.data.residentId == request.auth.uid));
      allow create: if isActiveResident() && request.resource.data.residentId == request.auth.uid;
      allow update: if isStaff() || (signedIn() && resource.data.residentId == request.auth.uid);
      allow delete: if isStaff();
    }

    // ---- Driver applications ----
    // Holds the document photo links, so only the Driver and the Admin of their barangay may read it.
    match /Driver_Applications/{applicationId} {
      // Only the Admin of the same barangay may read or review it.
      // (Old applications with no barangay can only be read by their Driver.)
      allow read:   if signedIn() && (resource.data.driverUid == request.auth.uid
        || isAdminOf(resource.data.get("barangay", "")));
      // A new application must start as "Pending".
      // Its id must be the driver's own uid, so each driver has one application.
      allow create: if signedIn()
        && applicationId == request.auth.uid
        && request.resource.data.driverUid == request.auth.uid
        && request.resource.data.status == "Pending";
      // An Admin of that barangay may only Approve or Reject, and may not move it to another barangay.
      allow update: if isAdminOf(resource.data.get("barangay", ""))
        && request.resource.data.get("barangay", "") == resource.data.get("barangay", "")
        && request.resource.data.status in ["Approved", "Rejected"];
      allow delete: if false;
    }

    // ---- Resident proof of residency (one per Resident, document id = their uid) ----
    // Holds the document photo link, so only the Resident and the Admin of their barangay may read it.
    // A Resident may only create their own, and only as "Pending". Only that Admin may change it.
    match /residentVerifications/{uid} {
      // Only the Admin of the same barangay may read or review it.
      allow read:   if signedIn() && (request.auth.uid == uid || isAdminOf(resource.data.barangay));
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.status == "Pending";
      // An Admin of that barangay may only Approve ("Active") or Reject, and may not move it to another barangay.
      allow update: if isAdminOf(resource.data.barangay)
        && request.resource.data.barangay == resource.data.barangay
        && request.resource.data.status in ["Active", "Rejected"];
      allow delete: if false;
    }

    // ---- Vehicle readiness checklists ----
    // Approved drivers only, like vehicles (architecture-review.md C1).
    match /vehicleChecklists/{checklistId} {
      allow read:           if isStaff() || isDriver();
      allow create, update: if isApprovedDriver();
      allow delete:         if false;
    }

    // ---- Admin bookkeeping (used by the Operations panel) ----
    match /activityLogs/{logId} {
      allow read, create:   if isStaff();
      allow update, delete: if false;
    }
    match /vehicleMaintenance/{id} { allow read, write: if isAdmin(); }
    match /staffInvitations/{id}   { allow read, write: if isAdmin(); }
    match /deletionRequests/{id}   { allow read, write: if isAdmin(); }
    // Residents read only this one document, for the office phone shown on the
    // emergency-alert fallback. Every other systemSettings document stays staff-only.
    match /systemSettings/operational {
      allow read:  if signedIn();
      allow write: if isAdmin();
    }
    match /systemSettings/{id} {
      allow read:  if isStaff();
      allow write: if isAdmin();
    }

    // ---- Everything else is denied ----
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
