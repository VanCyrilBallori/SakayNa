{
  "expo": {
    "name": "sakayna",
    "slug": "sakayna",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./Photos_/Logo (Secondary).png",
    "scheme": "sakayna",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./Photos_/Logo (Secondary).png",
        "monochromeImage": "./Photos_/Logo (Secondary).png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "package": "com.vancyrilballori.sakayna"
    },
    "web": {
      "output": "static",
      "favicon": "./Photos_/Logo (Secondary).png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./Photos_/Logo (Secondary).png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow SakayNa to use your location to fill a pickup address for a transport request. SakayNa does not track your location in the background."
        }
      ],
      "expo-font",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3606a4c7-d449-4391-b8e3-b0d7b3a31090"
      }
    }
  }
}
